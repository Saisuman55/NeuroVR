# Environment Variables — NeuroVR 3D
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# ── Model download ────────────────────────────────────────────────────────────
# HuggingFace token — required only if downloading private model weights
HF_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────
# Override the inference device (auto | cuda | mps | cpu)
NEUROVR_DEVICE=

# Disable MPS on macOS (recommended for Flask threading stability)
DISABLE_MPS=1
PYTORCH_ENABLE_MPS_FALLBACK=1
