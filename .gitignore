# NeuroVR 3D — Git Ignore

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Runtime outputs (generated at runtime — do not commit) ───────────────────
outputs/
!outputs/.gitkeep

# ── MRI / Medical imaging data (NEVER commit patient data) ────────────────────
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.nrrd
# Exception: small legally-distributable demo files in data/real_brats/
!data/real_brats/*.nii.gz

# ── Training datasets and large archives ─────────────────────────────────────
data/training/
*.zip
*.tar
*.tar.gz
*.tgz

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# ── Node (if frontend build tools are added later) ───────────────────────────
node_modules/
.cache/
.parcel-cache/
.vite/

# ── Large model checkpoints — use scripts/download_bundle.py instead ─────────
# models/monai/ is intentionally committed (small config + weights needed offline)
# models/classifier/ and models/segmenter/ were archived — not in production

# ── Archive (reference only — not deployed) ───────────────────────────────────
archive/

# ── Training outputs ──────────────────────────────────────────────────────────
results/
data/raw/
data/splits.json
*.pt
!models/monai/**/*.pt

# ── Dataset ───────────────────────────────────────────────────────────────────
data/raw/
data/training/msd_task01/
